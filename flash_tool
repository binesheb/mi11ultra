using System;
using System.Diagnostics;
using System.IO;
using System.Windows.Forms;

namespace Mi11UltraFlashingApp
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            // A recovery ROM ZIP must not be passed directly to `fastboot flash system`.
            // Keep this prototype limited to device checks and an explicitly selected boot image.
            DialogResult result = MessageBox.Show(
                "This prototype will only check the connected device and can optionally flash an explicitly selected boot.img. " +
                "ROM ZIP flashing and bootloader unlocking are intentionally disabled until package and device validation are implemented.",
                "Mi 11 Ultra Flash Tool - Safety Check",
                MessageBoxButtons.OKCancel,
                MessageBoxIcon.Warning);

            if (result != DialogResult.OK)
            {
                return;
            }

            string bootImg = "";
            DialogResult bootImgResult = MessageBox.Show(
                "Do you want to select a boot.img file for flashing?",
                "Flash custom boot.img?",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question);

            if (bootImgResult == DialogResult.Yes)
            {
                OpenFileDialog openFileDialog = new OpenFileDialog
                {
                    Title = "Select boot.img file",
                    Filter = "boot.img files (*.img)|*.img"
                };

                if (openFileDialog.ShowDialog() == DialogResult.OK)
                {
                    bootImg = openFileDialog.FileName;
                }
                else
                {
                    return;
                }
            }

            ProcessStartInfo startInfo = new ProcessStartInfo
            {
                FileName = "cmd.exe",
                RedirectStandardInput = true,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            Process cmdProcess = new Process();
            cmdProcess.StartInfo = startInfo;
            cmdProcess.Start();

            cmdProcess.StandardInput.WriteLine("adb devices");
            cmdProcess.StandardInput.WriteLine("adb reboot bootloader");
            cmdProcess.StandardInput.WriteLine("fastboot devices");

            if (!String.IsNullOrEmpty(bootImg))
            {
                DialogResult confirm = MessageBox.Show(
                    "Flash the selected boot.img to the currently connected device?\n\n" + bootImg,
                    "Confirm boot image flash",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Warning);

                if (confirm == DialogResult.Yes)
                {
                    cmdProcess.StandardInput.WriteLine("fastboot flash boot \"" + bootImg + "\"");
                }
            }

            cmdProcess.StandardInput.WriteLine("fastboot reboot");
            cmdProcess.StandardInput.Close();

            progressBar1.Visible = true;
            statusStrip1.Visible = true;
            toolStripStatusLabel1.Text = "Checking device...";

            while (!cmdProcess.StandardOutput.EndOfStream)
            {
                string output = cmdProcess.StandardOutput.ReadLine();
                if (String.IsNullOrEmpty(output))
                {
                    continue;
                }

                if (output.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    toolStripStatusLabel1.Text = "Error: " + output;
                    break;
                }

                if (output.IndexOf("finished", StringComparison.OrdinalIgnoreCase) >= 0 ||
                    output.IndexOf("OKAY", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    toolStripStatusLabel1.Text = "Command completed successfully.";
                }
            }

            string errorOutput = cmdProcess.StandardError.ReadToEnd();
            cmdProcess.WaitForExit();

            if (!String.IsNullOrWhiteSpace(errorOutput))
            {
                toolStripStatusLabel1.Text = "Error: " + errorOutput.Trim();
            }
        }
    }
}
